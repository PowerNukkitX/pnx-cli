{
  "name": "pnx-suite",
  "private": true,
  "description": "PowerNukkitX monorepo — @powernukkitx/cli (npm) and the PowerNukkitX desktop app",
  "workspaces": [
    "packages/*"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20.12.0"
  },
  "scripts": {
    "build": "npm run build --workspace packages/cli",
    "typecheck": "npm run typecheck --workspace packages/cli",
    "smoke": "npm run smoke --workspace packages/cli",
    "smoke:launcher": "npm run smoke:launcher --workspace packages/cli",
    "cli:dev": "npm run start --workspace packages/cli",
    "app:start": "npm run start --workspace packages/app",
    "app:dist": "npm run dist --workspace packages/app",
    "app:dist:linux": "npm run dist:linux --workspace packages/app",
    "app:dist:mac": "npm run dist:mac --workspace packages/app",
    "icons": "node packages/cli/scripts/make-icons.mjs"
  }
}
